{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spellbook.raddus.dev/schemas/errors.schema.json",
  "title": "Spellbook Diagnostics Registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "errors"],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "errors": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/diagnostic"
      }
    }
  },
  "$defs": {
    "diagnostic": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "severity", "message", "detected_at"],
      "properties": {
        "type": {
          "type": "string",
          "minLength": 1
        },
        "severity": {
          "enum": ["warning", "error"]
        },
        "target_root": {
          "type": "string",
          "minLength": 1
        },
        "agent": {
          "type": "string",
          "minLength": 1
        },
        "uid": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "integer",
          "minimum": 1
        },
        "message": {
          "type": "string",
          "minLength": 1
        },
        "detected_at": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
