{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spellbook.raddus.dev/schemas/targets.schema.json",
  "title": "Spellbook Known Targets Registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "targets"],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "targets": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/target"
      }
    }
  },
  "$defs": {
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["root", "harness_files"],
      "properties": {
        "root": {
          "type": "string",
          "minLength": 1
        },
        "harness_files": {
          "type": "array",
          "minItems": 1,
          "items": {
            "enum": ["AGENTS.md", "AGENT.md", "CLAUDE.md"]
          },
          "uniqueItems": true
        }
      }
    }
  }
}
