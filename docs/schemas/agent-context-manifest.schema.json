{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spellbook.raddus.dev/schemas/agent-context-manifest.schema.json",
  "title": "Spellbook Agent Context Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "name", "type", "version", "entrypoints", "paths", "resolver", "loader"],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "name": {
      "const": "spellbook-agent-context"
    },
    "type": {
      "const": "agent-context-package"
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "entrypoints": {
      "type": "object",
      "additionalProperties": false,
      "required": ["instruction_registries", "installed_registry", "known_targets", "diagnostics"],
      "properties": {
        "instruction_registries": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "minLength": 1
          }
        },
        "installed_registry": {
          "type": "string",
          "minLength": 1
        },
        "known_targets": {
          "type": "string",
          "minLength": 1
        },
        "diagnostics": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "paths": {
      "type": "object",
      "additionalProperties": false,
      "required": ["target_package", "system_registry", "instruction_store"],
      "properties": {
        "target_package": {
          "type": "string",
          "minLength": 1
        },
        "system_registry": {
          "type": "string",
          "minLength": 1
        },
        "instruction_store": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "resolver": {
      "type": "object",
      "additionalProperties": false,
      "required": ["command"],
      "properties": {
        "command": {
          "type": "string",
          "description": "Command path the harness should use to invoke the resolver, for example: ~/.spellbook/bin/spellbook-agent-context",
          "minLength": 1
        }
      }
    },
    "loader": {
      "type": "object",
      "additionalProperties": false,
      "required": ["activation", "read_order"],
      "properties": {
        "activation": {
          "const": "trigger_match"
        },
        "read_order": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
